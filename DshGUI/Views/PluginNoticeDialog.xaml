<Window x:Class="DshGUI.Views.PluginNoticeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource AppForegroundBrush}">
    <Border Padding="20" Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel>
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       LineHeight="22"
                       FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="知道了"
                        Width="88"
                        Height="32"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        IsCancel="True"
                        Click="OnOkClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
