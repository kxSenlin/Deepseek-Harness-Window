<Window x:Class="DshGUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:DshGUI.ViewModels"
        xmlns:views="clr-namespace:DshGUI.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="DeepSeek Harness"
        WindowStyle="None"
        ResizeMode="CanResize"
        MinWidth="800"
        MinHeight="600"
        Background="{DynamicResource AppBackgroundBrush}"
        StateChanged="OnStateChanged"
        Loaded="OnLoaded"
        Closing="OnClosing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="-1"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border CornerRadius="8"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{StaticResource WindowOutlineBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image x:Name="TitleIcon" Width="16" Height="16" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource AppForegroundBrush}"
                                   Text="{Binding WindowTitle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="OnPinClick"
                                ToolTip="置顶"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource TitleBarButtonStyle}">
                            <Path Data="M16,12V4h1V2H7v2h1v8l-2,2v2h5.2v6h1.6v-6H18v-2L16,12z"
                                  Width="13" Height="13" Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}">
                                        <Setter Property="Fill">
                                            <Setter.Value>
                                                <Binding Path="Foreground"
                                                         RelativeSource="{RelativeSource AncestorType=Button}" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Button x:Name="PluginManagerButton"
                                Click="OnPluginManagerClick"
                                ToolTip="插件管理"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource TitleBarButtonStyle}">
                            <Path Data="M20.5,11H19V7c0,-1.1 -0.9,-2 -2,-2h-4V3.5C13,2.12 11.88,1 10.5,1S8,2.12 8,3.5V5H4C2.9,5 2.01,5.9 2.01,7v3.8H3.5c1.49,0 2.7,1.21 2.7,2.7s-1.21,2.7 -2.7,2.7H2V20c0,1.1 0.9,2 2,2h3.8v-1.5c0,-1.49 1.21,-2.7 2.7,-2.7s2.7,1.21 2.7,2.7V22H17c1.1,0 2,-0.9 2,-2v-4h1.5c1.38,0 2.5,-1.12 2.5,-2.5S21.88,11 20.5,11z"
                                  Width="14" Height="14" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <TranslateTransform Y="-0.5" />
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                        <Button x:Name="SettingsButton"
                                Click="OnSettingsClick"
                                ToolTip="DshGUI 设置"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource TitleBarButtonStyle}">
                            <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                                  Width="14" Height="14" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="MinimizeButton"
                                Click="OnMinimizeClick"
                                ToolTip="最小化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource TitleBarButtonStyle}">
                            <Path Data="M 1,5 H 9"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Click="OnMaximizeClick"
                                ToolTip="最大化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource TitleBarButtonStyle}">
                            <Path x:Name="MaximizeIconPath"
                                  Data="M 1.5,1.5 H 8.5 V 8.5 H 1.5 Z"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" />
                        </Button>
                        <Button x:Name="CloseButton"
                                Click="OnCloseClick"
                                ToolTip="关闭到托盘"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource CloseButtonStyle}">
                            <Path Data="M 1.5,1.5 L 8.5,8.5 M 8.5,1.5 L 1.5,8.5"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 设置抽屉（与 WebView 并排，避免 HwndHost 遮挡） -->
                <views:SettingsView x:Name="SettingsViewControl"
                                    Grid.Column="0"
                                    DataContext="{x:Null}"
                                    Visibility="Collapsed" />

                <!-- 主内容区 -->
                <Grid Grid.Column="1">
                    <!-- WebView 在就绪前保持隐藏，避免 HwndHost 遮挡加载面板 -->
                    <wv2:WebView2 x:Name="WebView" Margin="1,0,1,1" Visibility="Collapsed" />

                    <!-- 启动 / 安装 / 状态面板 -->
                    <Border x:Name="LoadingPanel" Background="{DynamicResource AppBackgroundBrush}">
                        <Grid Margin="56,40">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="StatusText"
                                       Grid.Row="0"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />

                            <ProgressBar x:Name="InstallProgress"
                                         Grid.Row="1"
                                         Width="440"
                                         Height="6"
                                         Margin="0,24,0,0"
                                         HorizontalAlignment="Center"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed" />

                            <TextBlock x:Name="ElapsedText"
                                       Grid.Row="2"
                                       Margin="0,12,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       HorizontalAlignment="Center" />

                            <Border x:Name="LogContainer"
                                    Grid.Row="3"
                                    Margin="0,20,0,0"
                                    Height="200"
                                    Background="#11000000"
                                    BorderBrush="#22000000"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Padding="10,8">
                                    <TextBox x:Name="InstallLog"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Foreground="{DynamicResource SubtleTextBrush}"
                                             TextWrapping="NoWrap" />
                                </ScrollViewer>
                            </Border>

                            <StackPanel x:Name="MirrorSelector"
                                        Grid.Row="5"
                                        Margin="0,20,0,0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Visibility="Collapsed">
                                <TextBlock Text="镜像源："
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           Foreground="{DynamicResource AppForegroundBrush}" />
                                <RadioButton x:Name="MirrorOfficial"
                                             GroupName="Mirror"
                                             Content="官方源"
                                             VerticalAlignment="Center"
                                             Margin="0,0,16,0"
                                             Foreground="{DynamicResource AppForegroundBrush}" />
                                <RadioButton x:Name="MirrorNpmmirror"
                                             GroupName="Mirror"
                                             Content="国内镜像（npmmirror）"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource AppForegroundBrush}" />
                            </StackPanel>

                            <StackPanel x:Name="ActionButtons"
                                        Grid.Row="6"
                                        Margin="0,24,0,0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Visibility="Collapsed">
                                <Button x:Name="PrimaryActionButton"
                                        MinWidth="128"
                                        Height="36"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="OnPrimaryActionClick" />
                                <Button x:Name="SecondaryActionButton"
                                        MinWidth="128"
                                        Height="36"
                                        Padding="20,0"
                                        Margin="12,0,0,0"
                                        Click="OnSecondaryActionClick"
                                        Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
