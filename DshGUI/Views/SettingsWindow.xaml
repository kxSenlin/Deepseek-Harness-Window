<Window x:Class="DshGUI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DshGUI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
        Title="DshGUI 设置"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="主题" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ComboBox SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" Margin="0,0,0,16">
            <ComboBoxItem Content="跟随系统" />
            <ComboBoxItem Content="浅色" />
            <ComboBoxItem Content="深色" />
        </ComboBox>

        <CheckBox Content="忙完通知（最小化/托盘时提醒）"
                  IsChecked="{Binding NotifyOnComplete}" Margin="0,0,0,8" />
        <CheckBox Content="开机自启"
                  IsChecked="{Binding AutoStart}" Margin="0,0,0,8" />

        <CheckBox Content="全局快捷键（显示/隐藏窗口）"
                  IsChecked="{Binding HotkeyEnabled}" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBox Text="{Binding HotkeyDisplay, Mode=OneWay}" IsReadOnly="True"
                     Width="150" Height="28" VerticalContentAlignment="Center" />
            <Button x:Name="RecordButton" Content="录制" Width="64" Height="28" Margin="8,0,0,0"
                    Click="OnRecordHotkeyClick" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" Width="80" Height="28" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}" IsDefault="True" />
            <Button Content="取消" Width="80" Height="28"
                    Command="{Binding CancelCommand}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
