<Window x:Class="DshGUI.Views.PluginConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource AppForegroundBrush}">
    <Border Padding="20" Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel>
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       LineHeight="20" />
            <TextBlock x:Name="InputLabel"
                       Text="请输入插件名以确认："
                       Margin="0,16,0,6"
                       Visibility="Collapsed" />
            <TextBox x:Name="NameInput"
                     Height="30"
                     Visibility="Collapsed" />
            <TextBlock x:Name="ErrorText"
                       Foreground="#E81123"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="确认"
                        Width="88"
                        Height="32"
                        Margin="0,0,10,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="OnOkClick" />
                <Button Content="取消"
                        Width="88"
                        Height="32"
                        IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
