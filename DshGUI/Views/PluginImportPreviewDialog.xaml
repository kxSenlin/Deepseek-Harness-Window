<Window x:Class="DshGUI.Views.PluginImportPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入插件包"
        Width="560"
        Height="480"
        MinWidth="500"
        MinHeight="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource AppForegroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="以下插件已存在，导入时将跳过（不替换）："
                   FontWeight="SemiBold" />
        <ListBox x:Name="DuplicatesList"
                 Grid.Row="1"
                 Height="120"
                 Margin="0,8,0,0"
                 Background="{DynamicResource SurfaceBrush}"
                 Foreground="{DynamicResource AppForegroundBrush}"
                 BorderBrush="{DynamicResource ControlBorderBrush}"
                 BorderThickness="1" />

        <TextBlock Grid.Row="2"
                   Text="勾选要导入的插件："
                   FontWeight="SemiBold"
                   Margin="0,12,0,0" />
        <ItemsControl x:Name="AdditionsItemsControl"
                      Grid.Row="3"
                      Margin="0,8,0,0"
                      Background="{DynamicResource SurfaceBrush}"
                      Foreground="{DynamicResource AppForegroundBrush}"
                      BorderBrush="{DynamicResource ControlBorderBrush}"
                      BorderThickness="1">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding IsSelectable}"
                              Margin="8,4" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="4"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SubtleTextBrush}"
                   Text="提示：内置组合包（dsh-base / dsh-web-app / dsh-headless）相关行不会显示在重名列表中。" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="继续导入"
                    Width="110"
                    Height="32"
                    Margin="0,0,10,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    Click="OnContinueClick" />
            <Button Content="取消"
                    Width="88"
                    Height="32"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
