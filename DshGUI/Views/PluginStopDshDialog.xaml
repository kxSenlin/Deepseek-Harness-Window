<Window x:Class="DshGUI.Views.PluginStopDshDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="停止 DeepSeek Harness"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource AppForegroundBrush}">
    <Border Padding="20" Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel>
            <TextBlock Text="检测到 DeepSeek Harness 正在运行"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       LineHeight="22" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="停止 DeepSeek Harness"
                        Height="34"
                        MinWidth="190"
                        Style="{StaticResource DangerButtonStyle}"
                        IsDefault="True"
                        Click="OnStopClick" />
                <Button Content="取消"
                        Width="88"
                        Height="34"
                        Margin="10,0,0,0"
                        IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
