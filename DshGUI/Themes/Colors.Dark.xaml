<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题画刷：与应用主题相关的颜色都放这里，运行时由 ThemeService 切换。 -->

    <!-- 窗口 / 内容区背景与主文字 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#FFFFFF" />

    <!-- 标题栏 -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="#1E1E1E" />

    <!-- 控件表面（按钮 / 下拉框 / 输入框 / 卡片） -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#454545" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A4A4A" />

    <!-- 强调色（主操作按钮等） -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4D6BFE" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5C78FF" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <!-- 次要文字（日志 / 计时等） -->
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A0A0A0" />
</ResourceDictionary>
