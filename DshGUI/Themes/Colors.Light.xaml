<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题画刷：与应用主题相关的颜色都放这里，运行时由 ThemeService 切换。 -->

    <!-- 窗口 / 内容区背景与主文字 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#1E1E1E" />

    <!-- 标题栏 -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="#F3F3F3" />

    <!-- 控件表面（按钮 / 下拉框 / 输入框 / 卡片） -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#D6D6D6" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#C8C8C8" />

    <!-- 强调色（主操作按钮等） -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4D6BFE" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3A57E8" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <!-- 次要文字（日志 / 计时等） -->
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#888888" />
</ResourceDictionary>
